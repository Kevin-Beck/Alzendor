  "quests": {
    "mf_water": {
      "name": "Rising Water",
      "start": "spade",
      "steps": {
        "spade": {
          "goal": "Take Ossa's spade: ASK OSSA ABOUT SPADE.",
          "on": {
            "ask": "ossa",
            "about": "spade"
          },
          "effects": [
            {
              "give": "spade"
            }
          ],
          "then": "dam"
        },
        "dam": {
          "goal": "Break the dam in the Reedways: USE SPADE ON DAM.",
          "on": {
            "use": "spade",
            "on": "dam"
          },
          "effects": [
            {
              "text": "The dam gives way with a rush."
            }
          ],
          "then": "weir"
        },
        "weir": {
          "goal": "Clear the old weir: USE SPADE ON WEIR.",
          "on": {
            "use": "spade",
            "on": "weir"
          },
          "effects": [
            {
              "text": "The weir runs again."
            }
          ],
          "then": "sluice"
        },
        "sluice": {
          "goal": "Dig out the sluice: USE SPADE ON SLUICE.",
          "on": {
            "use": "spade",
            "on": "sluice"
          },
          "effects": [
            {
              "take": "spade"
            },
            {
              "text": "The sluice grinds open, and the water drains out of Ploverhold."
            }
          ],
          "then": "back"
        },
        "back": {
          "goal": "Tell Ossa: ASK OSSA ABOUT WATER.",
          "on": {
            "ask": "ossa",
            "about": "water"
          },
          "effects": [
            {
              "give": "eel_spear"
            },
            {
              "xp": 200
            },
            {
              "reputation": {
                "faction": "mirefolk",
                "affinity": 15,
                "note": "You drained Ploverhold."
              }
            }
          ]
        }
      }
    },
    "mf_king": {
      "name": "The Toad King",
      "start": "kill",
      "steps": {
        "kill": {
          "goal": "Kill the Toad King in his court.",
          "on": {
            "kill": "toad_king"
          },
          "then": "back"
        },
        "back": {
          "goal": "Tell Ossa: ASK OSSA ABOUT KING.",
          "on": {
