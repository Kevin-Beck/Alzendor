# Copy to .env. Docker Compose reads it, and passes it to the game servers.

# Accounts (lowercase names) that may use admin commands such as `announce`.
ALZ_ADMINS=

ALZ_LOG_LEVEL=INFO

# Local testing only: hold every message to and from a client this many ms,
# each way, to try the game with lag (80 is a typical internet connection).
# ALZ_FAKE_LATENCY_MS=80
# And up to this much more, at random, message by message: a shaky connection.
# ALZ_FAKE_JITTER_MS=40

# New accounts allowed per client address per hour. Locally every client shares
# Docker's gateway address, so raise this if you make lots of test accounts.
ALZ_SIGNUPS_PER_HOUR=20

# Seconds a dropped connection keeps its player in the world for reconnecting.
ALZ_LINKDEAD_SECONDS=60

# Production only (docker-compose.prod.yml): the public domain name. Caddy gets
# a certificate for it, and browsers may only connect from https://<this>.
ALZ_DOMAIN=alzendor.example.com
